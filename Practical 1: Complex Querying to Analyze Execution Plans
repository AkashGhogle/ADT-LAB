SELECT
    e.emp_id,
    e.emp_name,
    e.salary,
    d.dept_name
FROM Employee e
JOIN Department d
    ON e.dept_id = d.dept_id
WHERE e.salary > 40000
ORDER BY e.salary DESC;

EXPLAIN
SELECT
    e.emp_id,
    e.emp_name,
    e.salary,
    d.dept_name
FROM Employee e
JOIN Department d
    ON e.dept_id = d.dept_id
WHERE e.salary > 40000
ORDER BY e.salary DESC;

CREATE INDEX idx_salary
ON Employee(salary);

EXPLAIN
SELECT *
FROM Employee
WHERE salary > 40000;
